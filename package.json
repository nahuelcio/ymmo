{
  "name": "claudi-mmo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p .",
    "loadtest": "tsx scripts/loadtest.ts",
    "start:node": "tsx server/src/index.ts",
    "start:rs": "server-rs/target/release/claudi-server",
    "export-data": "tsx scripts/export-data.ts",
    "build:rs": "npm run export-data && cargo build --release --manifest-path server-rs/Cargo.toml",
    "dev:rs": "npm run export-data && cargo run --release --manifest-path server-rs/Cargo.toml"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}

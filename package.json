{
  "name": "claudi-mmo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "server-rs/target/release/claudi-server",
    "typecheck": "tsc --noEmit -p .",
    "loadtest": "tsx tools/scripts/loadtest.ts",
    "start:rs": "server-rs/target/release/claudi-server",
    "export-data": "tsx tools/scripts/export-data.ts",
    "build:rs": "npm run export-data && cargo build --release --manifest-path server-rs/Cargo.toml",
    "dev:rs": "npm run export-data && cargo run --release --manifest-path server-rs/Cargo.toml"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
